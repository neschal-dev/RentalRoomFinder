// use prisma-8

// ============================================================
// FindMeAPlace: database contract
// x============================================================

// ------------------------------------------------------------
// Users: local copy of a Clerk user.
// Name, email, phone and password stay in Clerk.
// ------------------------------------------------------------
enum UserRole {
  @@type("pg/text@1")
  User = "user"
  Admin = "admin"
}

model User {
  id            Uuid      @id @onCreate(uuid())
  clerkId       String    @unique // Clerk's user id, e.g. "user_2abc..."
  role          UserRole  @default(User)
  phoneVerified Boolean   @default(false)
  freePostUsed  Boolean   @default(false) // the free first post
  createdAt     DateTime  @default(now())
  updatedAt     temporal.UpdatedAt

  listings      Listing[]
  payments      Payment[]
  reports       Report[]

  @@map("users")
}

// ------------------------------------------------------------
// Listings, their photos and facilities.
// Only the server changes a listing's status.
// ------------------------------------------------------------
enum PropertyType {
  @@type("pg/text@1")
  Room = "room"
  Flat = "flat"
  House = "house"
}

enum Furnishing {
  @@type("pg/text@1")
  None = "none"
  Semi = "semi"
  Full = "full"
}

enum ParkingType {
  @@type("pg/text@1")
  None = "none"
  Bike = "bike"
  Car = "car"
  Both = "both"
}

enum ListingStatus {
  @@type("pg/text@1")
  PendingPayment = "pending_payment"
  Active = "active"
  Hidden = "hidden"
  Removed = "removed"
  Expired = "expired"
}

enum FairPriceLabel {
  @@type("pg/text@1")
  Below = "below"
  Fair = "fair"
  Above = "above"
  NotEnoughData = "not_enough_data"
}

enum MediaType {
  @@type("pg/text@1")
  Image = "image"
  Video = "video"
}

model Listing {
  id                 Uuid               @id @onCreate(uuid())
  ownerId            Uuid
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  title              String
  description        String

  // The property
  propertyType       PropertyType
  bedrooms           Int
  sizeSqft           Int? // optional: the fair price must still work without it
  furnishing         Furnishing         @default(None)
  parking            ParkingType        @default(None)
  smokingAllowed     Boolean            @default(false)
  alcoholAllowed     Boolean            @default(false)
  petsAllowed        Boolean            @default(false)

  // Price and place
  rentPrice          Int // monthly rent in NPR
  city               String
  area               String
  latitude           Float
  longitude          Float
  // false: the public sees a circle of about 400 m, not the exact spot (the server hides the real point)
  showExactLocation  Boolean            @default(false)

  // Filled in by the server: the closest junction in the road graph (for Dijkstra)
  nearestNodeId      BigIntNumber?

  // Filled in by the server: the fair price result, saved so search does not recompute it
  benchmarkPrice     Int?
  fairPriceLabel     FairPriceLabel?
  comparableCount    Int                @default(0)
  fairPriceUpdatedAt DateTime?

  // Life of the listing
  status             ListingStatus      @default(PendingPayment)
  availableFrom      Date
  expiresAt          DateTime? // set when the listing becomes active
  createdAt          DateTime           @default(now())
  updatedAt          temporal.UpdatedAt

  media              ListingMedia[]
  facilities         ListingFacility[]
  payments           Payment[]
  reports            Report[]

  @@index([status, city, propertyType, rentPrice]) // search filters
  @@index([latitude, longitude]) // comparable properties nearby
  @@index([status, expiresAt]) // expiry job
  @@index([ownerId])
  @@map("listings")
}

model ListingMedia {
  id        Uuid      @id @onCreate(uuid())
  listingId Uuid
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String // link to the file in file storage
  mediaType MediaType
  sortOrder Int       @default(0)

  @@index([listingId])
  @@map("listing_media")
}

model Facility {
  id       Uuid              @id @onCreate(uuid())
  name     String            @unique
  listings ListingFacility[]

  @@map("facilities")
}

model ListingFacility {
  listingId  Uuid
  facilityId Uuid
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([listingId, facilityId])
  @@index([facilityId])
  @@map("listing_facilities")
}

// ------------------------------------------------------------
// Payments: one listing can have many payments
// (a failed try, then a success, then renewals).
// The free first post creates no payment row.
// ------------------------------------------------------------
enum PaymentProvider {
  @@type("pg/text@1")
  Khalti = "khalti"
  Esewa = "esewa"
}

enum PaymentStatus {
  @@type("pg/text@1")
  Started = "started"
  Success = "success"
  Failed = "failed"
}

model Payment {
  id            Uuid             @id @onCreate(uuid())
  listingId     Uuid
  listing       Listing          @relation(fields: [listingId], references: [id], onDelete: Restrict)
  userId        Uuid
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider      PaymentProvider
  amount        Int // NPR
  status        PaymentStatus    @default(Started)
  // OUR id for this try. We create it before the user pays and send it to the provider,
  // which sends it back, so we can match the reply to the right payment.
  transactionUuid String         @unique
  transactionId String? // the provider's own code, known after the provider replies
  createdAt     DateTime         @default(now())
  updatedAt     temporal.UpdatedAt

  @@unique([provider, transactionId])
  @@index([listingId])
  @@index([userId])
  @@map("payments")
}

// ------------------------------------------------------------
// Reports: one user can report a listing only once.
// After enough reports the listing is hidden.
// ------------------------------------------------------------
enum ReportReason {
  @@type("pg/text@1")
  Fake = "fake"
  WrongPrice = "wrong_price"
  AlreadyRented = "already_rented"
  Scam = "scam"
  Other = "other"
}

model Report {
  id         Uuid         @id @onCreate(uuid())
  listingId  Uuid
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId Uuid
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  createdAt  DateTime     @default(now())

  @@unique([listingId, reporterId])
  @@index([reporterId])
  @@map("reports")
}